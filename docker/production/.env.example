# Production — copier en /opt/timeplanning/.env sur le serveur et renseigner. Jamais dans le dépôt.

# Nom d'hôte public de l'application (sans https://) et URL complète
APP_HOST=timeplanning.example.internal
APP_BASE_URL=https://timeplanning.example.internal

# Google OAuth2 (client OIDC de production)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://accounts.google.com

# Base de données (le conteneur MariaDB est créé avec ces identifiants au premier démarrage)
DB_USERNAME=timemanager
DB_PASSWORD=change_me
DB_ROOT_PASSWORD=change_me_too

# Email
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=change_me
NOTIFICATION_ENABLED=true
NOTIFICATION_FROM=noreply@timemanager.fr

LOG_LEVEL_FR_TIMEMANAGER=INFO

# Let's Encrypt uniquement (voir docker-compose.yml)
ACME_EMAIL=admin@example.com
