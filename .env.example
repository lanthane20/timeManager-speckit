# Google OAuth2 (GOOGLE_CLIENT_ID est aussi injecté dans le build frontend : npm run inject-env)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# JWT (issuer Google — ne pas modifier)
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://accounts.google.com

# Base de données (ignoré en profil dev — mariadb4j gère tout)
DB_URL=jdbc:mariadb://localhost:3306/timemanager
DB_USERNAME=timemanager
DB_PASSWORD=change_me_in_production

# Email (désactivable en dev via NOTIFICATION_ENABLED=false)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=change_me_in_production
NOTIFICATION_ENABLED=false
NOTIFICATION_FROM=noreply@timemanager.fr

# URL du frontend — liens des emails de notification et redirections OIDC du build frontend
APP_BASE_URL=http://localhost:4200

# Serveur
SERVER_PORT=8080

# Profil Spring (dev | test | prod)
SPRING_PROFILES_ACTIVE=dev

# Logging (prod uniquement — JSON structuré)
LOG_LEVEL_FR_TIMEMANAGER=INFO
