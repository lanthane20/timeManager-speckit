<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="002-create-teams" author="timemanager">
        <createTable tableName="teams">
            <column name="id" type="CHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="parent_team_id" type="CHAR(36)">
                <constraints foreignKeyName="fk_teams_parent"
                    references="teams(id)"/>
            </column>
            <column name="validation_mode" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="n1_manager_id" type="CHAR(36)">
                <constraints nullable="false"
                    foreignKeyName="fk_teams_n1_manager"
                    references="users(id)"/>
            </column>
            <column name="n2_manager_id" type="CHAR(36)">
                <constraints foreignKeyName="fk_teams_n2_manager"
                    references="users(id)"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="team_members">
            <column name="team_id" type="CHAR(36)">
                <constraints nullable="false"
                    foreignKeyName="fk_team_members_team"
                    references="teams(id)"/>
            </column>
            <column name="user_id" type="CHAR(36)">
                <constraints nullable="false"
                    foreignKeyName="fk_team_members_user"
                    references="users(id)"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="team_members" columnNames="team_id,user_id"
            constraintName="pk_team_members"/>

        <rollback>
            <dropTable tableName="team_members"/>
            <dropTable tableName="teams"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
