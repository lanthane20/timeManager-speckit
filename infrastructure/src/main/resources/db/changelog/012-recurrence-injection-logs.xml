<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="012-create-recurrence-injection-logs" author="timemanager">
        <createTable tableName="recurrence_injection_logs">
            <column name="id" type="CHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pattern_id" type="CHAR(36)">
                <constraints nullable="false"
                    foreignKeyName="fk_injection_logs_pattern"
                    references="recurrence_patterns(id)"/>
            </column>
            <column name="source" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="injected_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="injected_by_user_id" type="CHAR(36)">
                <constraints nullable="false"
                    foreignKeyName="fk_injection_logs_user"
                    references="users(id)"/>
            </column>
            <column name="events_created_count" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="period_start" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="period_end" type="DATE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="recurrence_injection_logs"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
