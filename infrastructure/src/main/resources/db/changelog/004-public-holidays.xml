    <changeSet id="004-create-public-holidays" author="timemanager">
        <createTable tableName="public_holidays">
            <column name="holiday_date" type="DATE">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="label" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="year" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="public_holidays" indexName="idx_public_holidays_year">
            <column name="year"/>
        </createIndex>

        <!-- Jours fériés français 2026 -->
