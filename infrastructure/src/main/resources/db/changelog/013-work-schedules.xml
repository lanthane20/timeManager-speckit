<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="013-create-work-schedules" author="timemanager">
        <createTable tableName="work_schedules">
            <column name="id" type="CHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="CHAR(36)">
                <constraints nullable="false"
                    foreignKeyName="fk_work_schedules_user"
                    references="users(id)"/>
            </column>
            <!-- ex. MON,TUE,WED,THU,FRI — jours travaillés -->
            <column name="working_days_pattern" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="effective_from" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="effective_until" type="DATE"/>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="work_schedules"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
