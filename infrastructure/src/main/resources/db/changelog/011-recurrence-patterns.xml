<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="011-create-recurrence-patterns" author="timemanager">
        <createTable tableName="recurrence_patterns">
            <column name="id" type="CHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="employee_id" type="CHAR(36)">
                <constraints nullable="false"
                    foreignKeyName="fk_recurrence_patterns_employee"
                    references="users(id)"/>
            </column>
            <column name="absence_type_id" type="CHAR(36)">
                <constraints nullable="false"
                    foreignKeyName="fk_recurrence_patterns_type"
                    references="absence_types(id)"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="recurrence_patterns"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
